<?xml version="1.0" encoding="utf-8"?>
<!--
    主界面布局
    ============================================================
    信息层级（自上而下）：
      1. 顶部应用栏：页面标题 + 全局动作（搜索 / 排序 / 刷新）
      2. 路径栏：位置导航（根目录 / 上级 / 当前路径）——次级层级
      3. 内容区：文件列表（唯一可变区域），空白/错误状态以同位置覆盖层呈现
      4. 状态栏：连接状态与条目计数——最低层级的辅助信息
    FAB 承载当前上下文最常用的主操作（上传），并让出状态栏高度避免遮挡。
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_surface"
    tools:context=".MainActivity">

    <FrameLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- ===== 1. 顶部应用栏 ===== -->
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/app_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/color_surface"
                app:elevation="0dp">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/toolbar_height"
                    android:background="@android:color/transparent"
                    app:menu="@menu/menu_main"
                    app:navigationContentDescription="@string/action_menu"
                    app:navigationIcon="@drawable/ic_menu"
                    app:title="@string/app_name"
                    app:titleTextAppearance="@style/TextAppearance.RFM.TitleLarge" />

                <!-- ===== 2. 路径栏 ===== -->
                <LinearLayout
                    android:id="@+id/path_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_3"
                    android:paddingTop="@dimen/space_1"
                    android:paddingEnd="@dimen/space_3"
                    android:paddingBottom="@dimen/space_3">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_home"
                        style="@style/Widget.RFM.Button.Icon"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:contentDescription="@string/action_home"
                        app:icon="@drawable/ic_home" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_parent"
                        style="@style/Widget.RFM.Button.Icon"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:contentDescription="@string/action_parent"
                        app:icon="@drawable/ic_arrow_upward" />

                    <!-- 当前路径：可点击直接编辑（替换原版常驻输入框，降低视觉噪音） -->
                    <TextView
                        android:id="@+id/tv_path"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_marginEnd="@dimen/space_2"
                        android:layout_weight="1"
                        android:background="@drawable/bg_path_field"
                        android:clickable="true"
                        android:ellipsize="start"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:paddingStart="@dimen/space_4"
                        android:paddingEnd="@dimen/space_4"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.RFM.BodyMedium"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="/home/user/documents" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_refresh"
                        style="@style/Widget.RFM.Button.Icon"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:contentDescription="@string/action_refresh"
                        app:icon="@drawable/ic_refresh" />
                </LinearLayout>

                <!-- 搜索筛选：默认隐藏，通过工具栏放大镜切换 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_search"
                    style="@style/Widget.RFM.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/screen_margin"
                    android:layout_marginEnd="@dimen/screen_margin"
                    android:layout_marginBottom="@dimen/space_3"
                    android:hint="@string/search_hint"
                    android:visibility="gone"
                    app:endIconMode="clear_text"
                    app:startIconDrawable="@drawable/ic_search"
                    tools:visibility="visible">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.appbar.AppBarLayout>

            <!-- ===== 3. 内容区 ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipe_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_files"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="@dimen/space_2"
                        android:paddingBottom="@dimen/space_8"
                        android:scrollbars="vertical" />
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

                <!-- 空状态 / 错误状态覆盖层 -->
                <LinearLayout
                    android:id="@+id/state_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_6"
                    android:paddingEnd="@dimen/space_6"
                    android:paddingBottom="@dimen/space_7"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/bg_empty_state_icon">

                        <ImageView
                            android:id="@+id/iv_state_icon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_empty_icon"
                            android:src="@drawable/ic_folder_open"
                            app:tint="?attr/colorPrimary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_state_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_5"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.RFM.HeadlineSmall"
                        tools:text="@string/empty_dir_title" />

                    <TextView
                        android:id="@+id/tv_state_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.RFM.BodyMedium"
                        tools:text="@string/empty_dir_message" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_state_action"
                        style="@style/Widget.RFM.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6"
                        android:visibility="gone"
                        tools:text="@string/action_retry"
                        tools:visibility="visible" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:visibility="invisible"
                    app:trackThickness="2dp"
                    tools:visibility="visible" />
            </FrameLayout>

            <!-- ===== 4. 状态栏 ===== -->
            <LinearLayout
                android:id="@+id/status_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/status_bar_height"
                android:background="@color/color_surface_container"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_5"
                android:paddingEnd="@dimen/space_5">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="@dimen/status_dot_size"
                    android:layout_height="@dimen/status_dot_size"
                    android:background="@drawable/bg_status_dot" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.RFM.LabelSmall"
                    tools:text="已连接 公司服务器" />

                <TextView
                    android:id="@+id/tv_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:textAppearance="@style/TextAppearance.RFM.LabelSmall"
                    tools:text="12 个项目" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_upload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/fab_margin"
            android:layout_marginBottom="@dimen/fab_clearance"
            android:contentDescription="@string/action_upload"
            app:srcCompat="@drawable/ic_upload" />
    </FrameLayout>

    <!-- ===== 导航抽屉：连接列表 ===== -->
    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_6"
            android:paddingTop="@dimen/space_6"
            android:paddingEnd="@dimen/space_6"
            android:paddingBottom="@dimen/space_5">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_brand_circle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_app_icon"
                    android:src="@drawable/ic_folder"
                    app:tint="?attr/colorOnPrimaryContainer" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.RFM.TitleMedium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/app_tagline"
                    android:textAppearance="@style/TextAppearance.RFM.BodySmall" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Widget.RFM.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_connections" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_connections"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_3" />

        <LinearLayout
            android:id="@+id/drawer_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_6"
            android:paddingEnd="@dimen/space_6"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/drawer_empty_title"
                android:textAppearance="@style/TextAppearance.RFM.TitleSmall" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center"
                android:text="@string/drawer_empty_message"
                android:textAppearance="@style/TextAppearance.RFM.BodySmall" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_new_connection"
                style="@style/Widget.RFM.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_new_connection"
                app:icon="@drawable/ic_add" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_theme"
                    style="@style/Widget.RFM.Button.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_theme"
                    app:icon="@drawable/ic_theme" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_about"
                    style="@style/Widget.RFM.Button.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_about"
                    app:icon="@drawable/ic_info" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
